```{=html}
<div class="gallery-grid">
<% for (const item of items) { %>
  <a href="<%= item.path %>" class="gallery-card">
    <span class="gallery-card-title"><% if (item.icon) { %><span class="gallery-card-icon" data-icon="<%= item.icon.includes(':') ? item.icon : 'bi:' + item.icon %>" aria-hidden="true"></span> <% } %><%= item.title %></span>
    <% if (item.description) { %><span class="gallery-card-desc"><%= item.description %></span><% } %>
  </a>
<% } %>
</div>
```
